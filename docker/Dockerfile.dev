FROM rsc-toolkit:latest

# Set environment variables
ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1

# re-install as editable
ARG PIP_EXTRAS="dev,trainer,models"
RUN pip uninstall -y rsc-toolkit && pip install -e ".[${PIP_EXTRAS}]"

# Cache hack: copy all project files after install
COPY . .

# Default command (can be overridden at runtime)
CMD ["python"]
