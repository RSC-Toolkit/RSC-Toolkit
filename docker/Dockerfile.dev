FROM rsc-toolkit:latest

# Set environment variables
ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1

# re-install as editable
RUN pip uninstall -y rsc-toolkit && pip install -e .[dev]

# Cache hack: copy all project files after install
COPY . .

# Default command (can be overridden at runtime)
CMD ["python"]
